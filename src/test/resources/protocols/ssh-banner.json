{
  "name": "ssh-banner",
  "port": 22,
  "timeout_sec": 5,
  "close_on_ready": true,
  "assembler": { "boundary": "delimited", "terminator": "txt:\n", "strip_cr": true, "max_message": 255 },
  "exchange": [
    { "expect": "txt:SSH-" },
    { "validate": { "prefix": "txt:SSH-2.0-", "report": "banner" } }
  ]
}
